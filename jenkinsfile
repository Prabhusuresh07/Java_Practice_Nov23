
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image'
                bat 'docker build -t opencartv121 .'
            }
        }

        stage('Execute Test Cases') {
            steps {
                echo 'Executing Selenium TestNG test cases inside Docker'

                bat '''
                    if not exist "%WORKSPACE%\\reports" mkdir "%WORKSPACE%\\reports"
                    if not exist "%WORKSPACE%\\screenshots" mkdir "%WORKSPACE%\\screenshots"

                    docker run --rm ^
                    -v "%WORKSPACE%\\reports:/app/reports" ^
                    -v "%WORKSPACE%\\screenshots:/app/screenshots" ^
                    opencartv121
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed'

            // Publish Extent HTML Report
            publishHTML(target: [
                reportName: 'Extent Reports',
                reportDir: 'reports',
                reportFiles: 'ExtentReport_*.html',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: true
            ])

            archiveArtifacts artifacts: 'reports/**,screenshots/**',
                             allowEmptyArchive: true
        }

        success {
            echo 'Build completed successfully'
        }

        failure {
            echo 'Build execution failed'
        }
    }
}

